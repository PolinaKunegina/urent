# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Основная таблица сети: часть ссылки docs.google.com/spreadsheets/d/<ID>/edit
# (можно не писать, а задать в боте: /setsheet ссылка)
SHEET_ID=
# Песочница новых партнёров (или /setsandbox ссылка)
SANDBOX_SHEET_ID=

# Руководители, которым в личку приходит утренняя сводка: @ники или числовые id.
# Каждый должен один раз нажать у бота Start.
MANAGERS=

REPORT_TIME=08:00
# Напоминание в чат и личные сообщения партнёрам; off — выключить
REMINDER_TIME=18:30
# Итоги недели: 0 — понедельник ... 3 — четверг ... 6 — воскресенье; off — выключить
WEEKLY_REPORT_DAY=3
WEEKLY_REPORT_TIME=15:00
TZ_NAME=Europe/Moscow
