# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Таблицы воронки: Подпись=ID_файла_на_Drive, через точку с запятой.
# ID берётся из ссылки docs.google.com/spreadsheets/d/<ID>/edit
SHEETS=Фамилия=ID_ФАЙЛА_ИЗ_ССЫЛКИ
SHEET_TAB=Воронка лидов

# Кому слать утренний отчёт (Наталья, Кир, Антон) — их user_id из команды /myid,
# или id общего чата руководителей. Через запятую.
REPORT_CHAT_IDS=
# Кто ещё может вызывать /report и /hours
ADMIN_IDS=

# Чат партнёров, где пишут отчёты с хэштегами (id из /myid в этом чате, начинается с -100)
PARTNERS_CHAT_ID=

REPORT_TIME=09:00
# Напоминание партнёрам заполнить таблицу до 19:00; off — выключить
REMINDER_TIME=18:00
TZ_NAME=Europe/Moscow

# Статусы, которые не считаются «в работе» (регулярное выражение)
EXCLUDE_STATUS_REGEX=отказ
