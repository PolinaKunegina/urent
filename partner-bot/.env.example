# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# ID общей таблицы воронки: часть ссылки docs.google.com/spreadsheets/d/<ID>/edit
SHEET_ID=
SHEET_TAB=Воронка лидов

# Руководители, которым в личку приходит утренняя сводка: @ники или числовые id.
# Каждый должен один раз написать боту /start.
MANAGERS=

# Чат партнёров. Можно не заполнять: руководитель отправит /bindchat в самом чате.
PARTNERS_CHAT_ID=

REPORT_TIME=08:00
# Напоминание в чат и личные сообщения партнёрам; off — выключить
REMINDER_TIME=18:30
# Недельная сводка: 0 — понедельник ... 6 — воскресенье; off — выключить
WEEKLY_DAY=0
TZ_NAME=Europe/Moscow

# Статусы, которые не считаются «в работе» (регулярное выражение)
EXCLUDE_STATUS_REGEX=отказ
# Сделка закрыта — следующее касание не нужно, лид не подсвечивается красным
CLOSED_STATUS_REGEX=стал ментором|оплатил пакет|240

# Ключ Claude для разбора плана и факта (console.anthropic.com → API Keys).
# Можно не писать сюда, а прислать боту в личку: /setkey sk-ant-…
ANTHROPIC_API_KEY=

# Подсветка «нет плана», лист «Часы из чата», лист «Партнёры» (нужна Google Таблица и доступ «Редактор»)
WRITE_BACK=on
HOURS_TAB=Часы из чата
